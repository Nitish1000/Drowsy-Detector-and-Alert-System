# Copy this file to ".env" and edit if needed.
PORT=5000

# Local MongoDB (default):
MONGO_URI=mongodb://127.0.0.1:27017/drowsy_detector
# Or MongoDB Atlas (free cloud database):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/drowsy_detector

# Optional: full path to the Python you installed the detector requirements in.
# Leave empty to auto-detect detector/venv, then "python" (Windows) / "python3".
# PYTHON_CMD=
